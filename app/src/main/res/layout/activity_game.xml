<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Center Board -->
    <com.barakatta.game.ui.BoardView
        android:id="@+id/boardView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.96"
        app:layout_constraintDimensionRatio="1:1" />

    <!-- Status Message (Centered above board) -->
    <TextView
        android:id="@+id/tvStatusMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:background="#88000000"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@id/boardView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp" />

    <!-- Player 3 (Amber) - TOP LEFT -->
    <LinearLayout
        android:id="@+id/playerBox3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="16dp">
        <TextView android:id="@+id/tvName3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:textStyle="bold" android:textSize="18sp"/>
        <TextView android:id="@+id/tvScore3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/gold"/>
        <FrameLayout android:layout_width="72dp" android:layout_height="72dp" android:layout_marginTop="8dp">
            <com.barakatta.game.ui.DiceView android:id="@+id/dice3" android:layout_width="match_parent" android:layout_height="match_parent"/>
        </FrameLayout>
        <LinearLayout android:id="@+id/chips3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- Player 1 (Blue) - TOP RIGHT -->
    <LinearLayout
        android:id="@+id/playerBox1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp">
        <TextView android:id="@+id/tvName1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:textStyle="bold" android:textSize="18sp"/>
        <TextView android:id="@+id/tvScore1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/gold"/>
        <FrameLayout android:layout_width="72dp" android:layout_height="72dp" android:layout_marginTop="8dp">
            <com.barakatta.game.ui.DiceView android:id="@+id/dice1" android:layout_width="match_parent" android:layout_height="match_parent"/>
        </FrameLayout>
        <LinearLayout android:id="@+id/chips1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- Player 0 (Red) - BOTTOM LEFT -->
    <LinearLayout
        android:id="@+id/playerBox0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="16dp">
        <LinearLayout android:id="@+id/chips0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp"/>
        <FrameLayout android:layout_width="72dp" android:layout_height="72dp" android:layout_marginBottom="8dp">
            <com.barakatta.game.ui.DiceView android:id="@+id/dice0" android:layout_width="match_parent" android:layout_height="match_parent"/>
        </FrameLayout>
        <TextView android:id="@+id/tvScore0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/gold"/>
        <TextView android:id="@+id/tvName0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:textStyle="bold" android:textSize="18sp"/>
    </LinearLayout>

    <!-- Player 2 (Green) - BOTTOM RIGHT -->
    <LinearLayout
        android:id="@+id/playerBox2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp">
        <LinearLayout android:id="@+id/chips2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp"/>
        <FrameLayout android:layout_width="72dp" android:layout_height="72dp" android:layout_marginBottom="8dp">
            <com.barakatta.game.ui.DiceView android:id="@+id/dice2" android:layout_width="match_parent" android:layout_height="match_parent"/>
        </FrameLayout>
        <TextView android:id="@+id/tvScore2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/gold"/>
        <TextView android:id="@+id/tvName2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:textStyle="bold" android:textSize="18sp"/>
    </LinearLayout>

    <!-- Confetti Overlay (Must be drawn on top of the board but behind the Winner UI) -->
    <com.barakatta.game.ui.ConfettiView
        android:id="@+id/confettiView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Winner Celebration Overlay -->
    <LinearLayout
        android:id="@+id/winnerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#99000000"
        android:elevation="20dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <TextView
            android:id="@+id/tvWinnerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="48sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:shadowColor="#000000"
            android:shadowDx="4"
            android:shadowDy="4"
            android:shadowRadius="8"
            android:layout_marginBottom="32dp"/>
            
        <Button
            android:id="@+id/btnPlayAgain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PLAY AGAIN"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingHorizontal="32dp"
            android:paddingVertical="16dp"
            android:backgroundTint="#4CAF50"
            android:textColor="@android:color/white"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
